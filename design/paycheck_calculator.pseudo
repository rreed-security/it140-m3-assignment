# Paycheck Calculator Pseudocode Template
#
# Complete every TODO prompt below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Your finished pseudocode should represent the same logic as your flowchart.
# Use clear indentation and appropriate pseudocode keywords such as
# INPUT, LET, IF, ELSE, and OUTPUT where they fit your design.

BEGIN paycheck_calculator

    INPUT hours_worked

    IF hours_worked > 40 THEN
        LET overtime_hours = hours_worked - 40 
        LET regular_pay = 40 * 20
        LET overtime_pay = overtime_hours * 30
        LET total_pay = regular_pay + overtime_pay 
    ELSE
        LET total_pay = hours_worked * 20
    ENDIF

    OUTPUT total_pay 

END paycheck_calculator

